# Copy this file to .env and change the values to match your Traefik setup.

# The domain name for Pokie. Point its DNS record at your Docker server.
POKIE_HOST=pokie.example.com

# The Docker network that your Traefik container uses.
TRAEFIK_NETWORK=traefik

# The Traefik entrypoint for HTTPS.
TRAEFIK_ENTRYPOINT=websecure

# The Traefik certificate resolver.
TRAEFIK_CERT_RESOLVER=letsencrypt
